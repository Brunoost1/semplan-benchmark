{
  "$id": "https://semplan-benchmark.local/schemas/budget_check.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "estimated_input_tokens": {
      "minimum": 0,
      "title": "Estimated Input Tokens",
      "type": "integer"
    },
    "estimated_output_tokens": {
      "minimum": 0,
      "title": "Estimated Output Tokens",
      "type": "integer"
    },
    "estimated_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Estimated Usd"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "monthly_limit_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Monthly Limit Usd"
    },
    "price_checked_at_utc": {
      "format": "date-time",
      "title": "Price Checked At Utc",
      "type": "string"
    },
    "remaining_monthly_budget_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Remaining Monthly Budget Usd"
    },
    "remaining_run_budget_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Remaining Run Budget Usd"
    },
    "request_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "run_budget_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Run Budget Usd"
    },
    "safety_multiplier": {
      "anyOf": [
        {
          "minimum": 1.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Safety Multiplier"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_hash",
    "model",
    "estimated_input_tokens",
    "estimated_output_tokens",
    "safety_multiplier",
    "estimated_usd",
    "run_budget_usd",
    "monthly_limit_usd",
    "remaining_run_budget_usd",
    "remaining_monthly_budget_usd",
    "price_checked_at_utc"
  ],
  "title": "BudgetCheck",
  "type": "object"
}
