{
  "$id": "https://semplan-benchmark.local/schemas/provider_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "idempotency_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Idempotency Hash",
      "type": "string"
    },
    "inference_parameters": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          },
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Inference Parameters",
      "type": "object"
    },
    "inputs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Metadata",
      "type": "object"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "output_schema_ref": {
      "minLength": 1,
      "title": "Output Schema Ref",
      "type": "string"
    },
    "output_schema_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Schema Sha256"
    },
    "prompt_id": {
      "minLength": 1,
      "title": "Prompt Id",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "system": {
      "minLength": 1,
      "title": "System",
      "type": "string"
    },
    "timeout_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 300,
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "provider",
    "model",
    "prompt_id",
    "prompt_sha256",
    "system",
    "inputs",
    "output_schema_ref",
    "timeout_seconds",
    "idempotency_hash"
  ],
  "title": "ProviderRequest",
  "type": "object"
}
