{
  "$defs": {
    "Approach": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "A4"
      ],
      "title": "Approach",
      "type": "string"
    },
    "DatasetSplit": {
      "enum": [
        "development",
        "validation",
        "test_public",
        "test_hidden",
        "multi_turn",
        "adversarial"
      ],
      "title": "DatasetSplit",
      "type": "string"
    },
    "ExecutionDesign": {
      "additionalProperties": false,
      "properties": {
        "analysis_plan": {
          "minLength": 1,
          "title": "Analysis Plan",
          "type": "string"
        },
        "design_id": {
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Design Id",
          "type": "string"
        },
        "primary_repetitions": {
          "maximum": 100,
          "minimum": 1,
          "title": "Primary Repetitions",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_case_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Scientific Case Ids",
          "type": "array"
        },
        "stability_additional_repetitions": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Stability Additional Repetitions",
          "type": "integer"
        },
        "stability_sampling_algorithm": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stability Sampling Algorithm"
        },
        "stability_sampling_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stability Sampling Seed"
        },
        "stability_subset_case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Stability Subset Case Ids",
          "type": "array"
        },
        "stability_subset_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stability Subset Sha256"
        }
      },
      "required": [
        "schema_version",
        "design_id",
        "analysis_plan",
        "scientific_case_ids",
        "primary_repetitions"
      ],
      "title": "ExecutionDesign",
      "type": "object"
    },
    "ExperimentMode": {
      "enum": [
        "dry-run",
        "replay",
        "pilot",
        "synchronous",
        "batch"
      ],
      "title": "ExperimentMode",
      "type": "string"
    },
    "ExperimentModelConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "reasoning_effort": {
          "minLength": 1,
          "title": "Reasoning Effort",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "id",
        "reasoning_effort"
      ],
      "title": "ExperimentModelConfig",
      "type": "object"
    },
    "PromptBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "output_schema_ref": {
          "minLength": 1,
          "title": "Output Schema Ref",
          "type": "string"
        },
        "output_schema_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema Sha256"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256",
        "output_schema_ref"
      ],
      "title": "PromptBinding",
      "type": "object"
    },
    "RunManifestStatus": {
      "enum": [
        "draft",
        "validated",
        "frozen",
        "running",
        "completed",
        "aborted",
        "invalidated"
      ],
      "title": "RunManifestStatus",
      "type": "string"
    }
  },
  "$id": "https://semplan-benchmark.local/schemas/run_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_paid": {
      "title": "Allow Paid",
      "type": "boolean"
    },
    "approaches": {
      "items": {
        "$ref": "#/$defs/Approach"
      },
      "minItems": 1,
      "title": "Approaches",
      "type": "array"
    },
    "benchmark_manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Benchmark Manifest Sha256",
      "type": "string"
    },
    "benchmark_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Benchmark Version"
    },
    "budget_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Budget Usd"
    },
    "catalog_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Catalog Sha256",
      "type": "string"
    },
    "code_commit": {
      "pattern": "^([0-9a-f]{7,40}|unknown)$",
      "title": "Code Commit",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "dataset_manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Dataset Manifest Sha256",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "dirty_tree": {
      "title": "Dirty Tree",
      "type": "boolean"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "execution_design": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionDesign"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_policy_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Policy Sha256",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/ExperimentMode"
    },
    "model": {
      "$ref": "#/$defs/ExperimentModelConfig"
    },
    "non_reportable": {
      "default": false,
      "title": "Non Reportable",
      "type": "boolean"
    },
    "price_table_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Price Table Sha256",
      "type": "string"
    },
    "prompts": {
      "additionalProperties": {
        "$ref": "#/$defs/PromptBinding"
      },
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/Approach"
      },
      "title": "Prompts",
      "type": "object"
    },
    "randomization_seed": {
      "title": "Randomization Seed",
      "type": "integer"
    },
    "repetitions": {
      "maximum": 100,
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "splits": {
      "items": {
        "$ref": "#/$defs/DatasetSplit"
      },
      "minItems": 1,
      "title": "Splits",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/RunManifestStatus"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "created_at_utc",
    "code_commit",
    "dirty_tree",
    "dataset_version",
    "dataset_manifest_sha256",
    "benchmark_manifest_sha256",
    "catalog_sha256",
    "approaches",
    "model",
    "prompts",
    "splits",
    "repetitions",
    "randomization_seed",
    "budget_usd",
    "price_table_sha256",
    "execution_policy_sha256",
    "mode",
    "allow_paid"
  ],
  "title": "RunManifest",
  "type": "object"
}
