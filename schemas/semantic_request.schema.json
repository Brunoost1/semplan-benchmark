{
  "$defs": {
    "ClarificationReasonCode": {
      "enum": [
        "AMBIGUOUS_METRIC",
        "AMBIGUOUS_DIMENSION",
        "AMBIGUOUS_ENTITY",
        "AMBIGUOUS_TIME_RANGE",
        "AMBIGUOUS_COMPARISON_BASIS",
        "AMBIGUOUS_RANKING_DIRECTION",
        "AMBIGUOUS_SCOPE"
      ],
      "title": "ClarificationReasonCode",
      "type": "string"
    },
    "ClarificationSpec": {
      "additionalProperties": false,
      "properties": {
        "options": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ClarificationReasonCode"
        }
      },
      "required": [
        "reason_code",
        "question",
        "options"
      ],
      "title": "ClarificationSpec",
      "type": "object"
    },
    "ComparisonSpec": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "mode": {
          "enum": [
            "period_over_period",
            "share_of_total"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "ComparisonSpec",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "asc",
        "desc"
      ],
      "title": "Direction",
      "type": "string"
    },
    "FilterSpec": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/Operator"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                    "type": "string"
                  },
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator"
      ],
      "title": "FilterSpec",
      "type": "object"
    },
    "Intent": {
      "enum": [
        "grouped_metric",
        "detail_lookup",
        "ranking",
        "comparison",
        "clarification",
        "out_of_scope"
      ],
      "title": "Intent",
      "type": "string"
    },
    "Operation": {
      "enum": [
        "REPLACE",
        "PATCH",
        "CLARIFY",
        "OUT_OF_SCOPE"
      ],
      "title": "Operation",
      "type": "string"
    },
    "Operator": {
      "enum": [
        "EQ",
        "NE",
        "IN",
        "NOT_IN",
        "GT",
        "GTE",
        "LT",
        "LTE",
        "BETWEEN",
        "IS_NULL",
        "IS_NOT_NULL",
        "CONTAINS_CANONICAL"
      ],
      "title": "Operator",
      "type": "string"
    },
    "OutOfScopeReasonCode": {
      "enum": [
        "UNSUPPORTED_DOMAIN",
        "WRITE_OPERATION",
        "PROHIBITED_DATA_ACCESS",
        "NON_ANALYTICS_REQUEST",
        "UNSUPPORTED_COMPUTATION",
        "PROMPT_EXTRACTION",
        "MALFORMED_INPUT"
      ],
      "title": "OutOfScopeReasonCode",
      "type": "string"
    },
    "SortSpec": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "field": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field",
        "direction"
      ],
      "title": "SortSpec",
      "type": "object"
    },
    "TimeGrain": {
      "enum": [
        "day",
        "week",
        "month",
        "quarter",
        "year"
      ],
      "title": "TimeGrain",
      "type": "string"
    }
  },
  "$id": "https://semplan-benchmark.local/schemas/semantic_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clarifications": {
      "items": {
        "$ref": "#/$defs/ClarificationSpec"
      },
      "title": "Clarifications",
      "type": "array"
    },
    "comparison": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComparisonSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Confidence"
    },
    "dimensions": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/FilterSpec"
      },
      "title": "Filters",
      "type": "array"
    },
    "intent": {
      "$ref": "#/$defs/Intent"
    },
    "limit": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limit"
    },
    "metrics": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Metrics",
      "type": "array"
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    },
    "out_of_scope_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutOfScopeReasonCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sort": {
      "items": {
        "$ref": "#/$defs/SortSpec"
      },
      "title": "Sort",
      "type": "array"
    },
    "time_grain": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeGrain"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "operation",
    "intent",
    "metrics",
    "dimensions",
    "filters",
    "sort",
    "clarifications",
    "confidence"
  ],
  "title": "SemanticRequestEnvelope",
  "type": "object"
}
